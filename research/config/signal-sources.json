{
  "global": {
    "userAgent": "Mozilla/5.0 (Windows NT 10.0; Win64; x64) OpsMailConsoleResearchBot/1.0",
    "requestTimeoutSeconds": 30,
    "maxRetries": 3,
    "retryBaseSeconds": 2,
    "maxItemsPerQuery": 6,
    "minimumPublishedYear": 2026,
    "priorityPublishedAfter": "2026-03-31",
    "staleBeforeOrOn": "2026-03-31",
    "candidateSourceDiscovery": {
      "enabled": true,
      "registryFile": "research/state/candidate-source-registry.yaml",
      "minimumDistinctReferrersForPromotion": 2,
      "allowSingleHighConfidenceCommunityThread": true,
      "excludeCommercialOnlyResources": true,
      "excludeSeoAndAffiliateResources": true
    },
    "positivePatterns": [
      "spf",
      "dkim",
      "dmarc",
      "postmaster",
      "snds",
      "junk",
      "spam folder",
      "inbox placement",
      "quarantine",
      "silent drop",
      "throttl",
      "blocklist",
      "blacklist",
      "warm",
      "reputation",
      "delist",
      "deliverability"
    ],
    "excludePatterns": [
      "seo service",
      "marketing agency",
      "affiliate",
      "guest post",
      "casino",
      "crypto giveaway"
    ],
    "painTypeRules": [
      {
        "name": "auth_ok_delivery_bad",
        "pattern": "(spf|dkim|dmarc).*(spam|junk|deliver|delivery|inbox)|(deliver|delivery).*(spf|dkim|dmarc)"
      },
      {
        "name": "low_volume_visibility_gap",
        "pattern": "low[- ]volume|small sender|postmaster|snds|no data|not enough data|insufficient data"
      },
      {
        "name": "warmup_rewarm",
        "pattern": "warm[- ]?up|re[- ]?warm|new domain|new ip|new tenant"
      },
      {
        "name": "junk_or_quarantine",
        "pattern": "junk|spam folder|quarantine|quarantined|clutter"
      },
      {
        "name": "silent_drop_or_throttle",
        "pattern": "silent drop|throttl|deferred|deferral|421|rate limit"
      },
      {
        "name": "blocklist_vs_reputation",
        "pattern": "blocklist|blacklist|delist|delisting|reputation issue|sender reputation"
      },
      {
        "name": "root_cause_visibility",
        "pattern": "root cause|visibility|explainability|combined monitoring|monitoring gap"
      }
    ],
    "segmentRules": [
      {
        "name": "low-volume",
        "pattern": "low[- ]volume|small sender|new domain|not enough data"
      },
      {
        "name": "mid-volume",
        "pattern": "mid[- ]volume|growing sender|warming program|shared ip"
      }
    ],
    "keywordClusters": [
      {
        "name": "auth-ok-delivery-bad",
        "terms": "\"SPF\" \"DKIM\" \"DMARC\" deliverability inbox spam"
      },
      {
        "name": "low-volume-no-data",
        "terms": "\"low volume\" sender postmaster SNDS \"no data\""
      },
      {
        "name": "warmup-rewarm",
        "terms": "\"new domain\" warmup rewarm throttling deliverability"
      },
      {
        "name": "junk-placement",
        "terms": "gmail outlook junk placement spam folder inbox"
      },
      {
        "name": "blocklist-remediation",
        "terms": "blocklist blacklist delist remediation sender reputation"
      },
      {
        "name": "visibility-root-cause",
        "terms": "\"inbox placement\" explainability visibility \"root cause\""
      }
    ]
  },
